<?xml version='1.0'?>

<!-- 배터리 판정 노드만 실행한다. 충전소 자동 복귀와 안전 게이트까지 필요한
     운영 환경에서는 mingky_bringup/mingky_system.launch.xml 을 사용한다. -->
<launch>
    <!-- 임계값은 전압이다. 퍼센트는 표시용 파생값이라 6.8V 아래·7.6V 위가
         전부 0%/100% 로 뭉개져 판정에 쓸 수 없다. -->
    <arg name="low_voltage" default="7.12"/>
    <arg name="confirm_count" default="3"/>
    <arg name="rearm_voltage" default="7.28"/>
    <arg name="trend_samples" default="5"/>
    <arg name="trend_rise_volt" default="0.05"/>
    <arg name="median_samples" default="3"/>
    <!-- 위험선은 확인 절차를 건너뛰는 값이라 현장에서 가장 자주 조정된다. -->
    <arg name="critical_voltage" default="6.80"/>
    <arg name="critical_count" default="2"/>
    <arg name="use_buzzer" default="true"/>
    <arg name="buzzer_script" default="/home/pinky/ap/battery_buzzer.py"/>
    <arg name="buzzer_level" default="danger"/>

    <node pkg="mingky_battery_guard" exec="battery_guard"
          name="battery_guard" output="screen">
        <param name="low_voltage" value="$(var low_voltage)"/>
        <param name="confirm_count" value="$(var confirm_count)"/>
        <param name="rearm_voltage" value="$(var rearm_voltage)"/>
        <param name="trend_samples" value="$(var trend_samples)"/>
        <param name="trend_rise_volt" value="$(var trend_rise_volt)"/>
        <param name="median_samples" value="$(var median_samples)"/>
        <param name="critical_voltage" value="$(var critical_voltage)"/>
        <param name="critical_count" value="$(var critical_count)"/>
        <param name="use_buzzer" value="$(var use_buzzer)"/>
        <param name="buzzer_script" value="$(var buzzer_script)"/>
        <param name="buzzer_level" value="$(var buzzer_level)"/>
    </node>
</launch>
