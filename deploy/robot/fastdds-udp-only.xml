<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS 를 UDPv4 만 쓰게 한다 — 공유메모리(SHM) 전송을 끈다.

  왜:
    부팅 때 서비스 5개(mingky-system · fg-teleop · mingky-gateway ·
    mingky-teleop-bridge · mingky-battery-pub)가 동시에 뜨면서 참가자들이
    같은 SHM 포트를 두고 경합한다. 일부가

        RTPS_TRANSPORT_SHM Error: Failed init_port fastrtps_port7011:
        open_and_lock_file failed

    로 실패하는데, 실패한 참가자는 그 뒤로 **같은 기계의 다른 프로세스와
    통신하지 못한다.** 프로세스 안에서는 멀쩡해서 노드 로그만 보면 정상으로
    보이는 것이 이 문제를 어렵게 만든다.

    실제로 하루에 다섯 번 다른 얼굴로 나왔다 — /mode 미수신, amcl 도달 불가,
    /battery/percent 미수신, TF 소실, 그리고 위치추정 실패. 서비스를 하나씩
    재시작하면 잠깐 낫고 다시 끊긴다.

  대가:
    같은 기계 안의 통신이 UDP 루프백을 탄다. 이 구성에서 오가는 것은 스캔
    (10 Hz · 수 KB)과 상태 토픽이라 부담이 되지 않는다. 카메라는 DDS 가 아니라
    별도 스트리머와 역터널로 나가므로 영향이 없다.

  되돌리기:
    /etc/mingky/robot.env 의 FASTRTPS_DEFAULT_PROFILES_FILE 줄을 지우고
    재부팅하면 기본(SHM + UDP)으로 돌아온다.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>

    <!-- is_default_profile 이라 이 파일을 읽는 모든 참가자에 적용된다.
         useBuiltinTransports 를 false 로 두어야 SHM 이 추가되지 않는다. -->
    <participant profile_name="udp_only_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>udp_only_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
