# 이 로봇의 정체와 바라볼 관제 서버.
# 로봇마다 다른 유일한 값이라 코드나 유닛 파일이 아니라 여기에 둔다.
MINGKY_ROBOT_ID=pinky-01
MINGKY_BACKEND_URL=https://mingkycarepro.site/api

# 저상 장애물은 local/global costmap 기반 초음파/LiDAR 융합만 사용한다.
# 기존 목표 취소형 sidestep 모드는 폐기되어 환경변수로 켤 수 없다.
# 문제가 있을 때만 false로 롤백한다.
MINGKY_LOW_OBSTACLE_FUSION_ENABLED=true

# 화재 감지 운영 설정. 추론 서버가 상시 실행되고 /health 응답을 확인한 뒤
# true로 바꾼다. URL은 반드시 /infer 경로까지 적는다.
MINGKY_FIRE_EVAC_ENABLED=false
MINGKY_FIRE_INFER_SERVER_URL=http://192.168.0.30:5000/infer

# 환자 QR 거리 기반 감속·대기 시험. YOLO URL을 비우면 QR 거리만 사용한다.
MINGKY_PATIENT_FOLLOW_ENABLED=true
MINGKY_PATIENT_FOLLOW_INFER_SERVER_URL=http://192.168.0.30:5001/infer
MINGKY_PATIENT_FOLLOW_SLOW_DISTANCE_M=0.15
MINGKY_PATIENT_FOLLOW_STOP_DISTANCE_M=0.30
MINGKY_PATIENT_FOLLOW_TRACKING_GRACE_SEC=2.0
MINGKY_PATIENT_FOLLOW_INITIAL_ACQUIRE_GRACE_SEC=4.0
MINGKY_PATIENT_FOLLOW_INITIAL_ACQUIRE_DISTANCE_M=0.30
MINGKY_PATIENT_FOLLOW_TARGET_HEIGHT_M=0.13
MINGKY_PATIENT_FOLLOW_PARTIAL_BBOX_MAX_DISTANCE_M=0.35
MINGKY_PATIENT_FOLLOW_PARTIAL_BBOX_CONF_THRESHOLD=0.70
MINGKY_PATIENT_FOLLOW_SLOW_SPEED_PERCENT=35.0

# 하향 명령(orders) 폴링 주기 [초]. 0 이면 끈다.
MINGKY_ORDER_INTERVAL=3.0

# 롱폴링 대기 [초]. 서버가 명령이 걸릴 때까지 이 시간까지 응답을 붙들고
# 있는다. 0 이면 위 주기대로 반복 조회한다.
MINGKY_ORDER_WAIT=25.0

# 역터널이 클라우드에서 점유할 포트. **로봇마다 달라야 한다.**
#
# 서버의 authorized_keys 가 키별로 permitlisten 을 걸어 두므로, 값이 틀리면
# 서버가 바인딩을 거부한다. 유닛에 ExitOnForwardFailure=yes 가 있어 터널이
# 뜨지 않고 재시작만 반복하며, 그 로봇은 접근 불가가 된다.
#
#   pinky-01   SSH 22021   Foxglove 18765
#   pinky-02   SSH 22022   Foxglove 18766
MINGKY_SSH_TUNNEL_PORT=22021
MINGKY_FOXGLOVE_TUNNEL_PORT=18765

# 관제 카메라 MJPEG 역터널. 로봇마다 두 포트를 단독 사용한다.
# pinky-01: 18801(front), 18802(rear)
# pinky-02: 18803(front), 18804(rear)
MINGKY_CAMERA_FRONT_TUNNEL_PORT=18801
MINGKY_CAMERA_REAR_TUNNEL_PORT=18802
