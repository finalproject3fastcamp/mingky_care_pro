[Unit]
Description=유지보수용 SSH 역터널 (로봇 → 클라우드)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pinky
# 공유기를 빼면 로봇 IP 로 직접 붙을 수 없다. 이 터널이 유일한 접근 경로가
# 되므로 fg-tunnel 보다 먼저 살아 있어야 한다.
ExecStart=/usr/bin/ssh -N \
  -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=20 -o ServerAliveCountMax=3 \
  -o StrictHostKeyChecking=accept-new \
  -o IdentitiesOnly=yes \
  -i /home/pinky/.ssh/id_fgtunnel \
  -R 127.0.0.1:22021:127.0.0.1:22 \
  fgtunnel@161.118.208.109
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
