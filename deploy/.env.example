POSTGRES_DB=mingky_care
POSTGRES_USER=mingky_care
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# 브라우저와 Pinky가 접속할 관제 서버 포트
WEB_PORT=8080

# 안내 중 로봇 두절·통합 시스템 장애가 이 시간 지속되면 세션 취소
SESSION_FAILURE_CANCEL_AFTER_SEC=30

# 심각한 사건(화재·비상정지·통신 두절 등)을 보낼 Slack 또는 Discord 웹훅.
# 비워두면 알림이 꺼진다. 어느 쪽인지는 URL 로 알아서 판별한다.
# 예: https://hooks.slack.com/services/... 또는 https://discord.com/api/webhooks/...
ALERT_WEBHOOK_URL=

# 의료진 화면에 카메라 미리보기가 필요할 때만 설정
# 예: http://192.168.0.21:8080/stream
VITE_CAMERA_STREAM_URL=

# OMX 조제/포장 스테이션 러너 주소 (역터널 경유). 비워두면 원격 프록시를 쓰지
# 않고 로컬/시뮬로 돈다. 각 OMX 박스가 자기 러너(:8800)를 클라우드 host 의
# 127.0.0.1:2203x 로 역포워딩하고, 아래처럼 host.docker.internal 로 부른다.
#   omx-01(조제) → 22031, omx-02(포장) → 22032
# 예:
#   MINGKY_OMX_DISPENSE_URL=http://host.docker.internal:22031
#   MINGKY_OMX_PACK_URL=http://host.docker.internal:22032
MINGKY_OMX_DISPENSE_URL=
MINGKY_OMX_PACK_URL=
