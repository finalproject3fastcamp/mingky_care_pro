server {
    listen 80;
    listen [::]:80;
    server_name mingkycarepro.site www.mingkycarepro.site;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        # 조제 진행(SSE, /api/pharmacy/progress)은 스트림이다. 앞단 nginx 는
        # 백엔드의 X-Accel-Buffering:no 를 다음 홉으로 전달하지 않으므로, 이
        # 호스트 nginx 가 버퍼링하면 진행이 몰아서/영영 안 온다(45초 워치독 반복).
        proxy_buffering off;
        # 대시보드의 실시간 조작이 /api/ 아래로 WebSocket 을 연다.
        # 업그레이드 헤더를 넘기지 않으면 평범한 GET 이 되어 404 가 된다.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mingkycarepro.site/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mingkycarepro.site/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


    # Foxglove 역터널 중계. 경로의 토큰이 사실상 접근 열쇠이므로 공개 금지.
    # 브리지는 읽기 전용(clientPublish 없음)으로 띄운다.
    location /fg/<FOXGLOVE_TOKEN>/pinky1/ {
        proxy_pass http://127.0.0.1:18765/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /fg/<FOXGLOVE_TOKEN>/pinky2/ {
        proxy_pass http://127.0.0.1:18766/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 카메라 원본 ROS 토픽은 클라우드로 보내지 않는다. 로봇에서 3 FPS로 만든
    # MJPEG만 역터널로 받아 같은 오리진에서 전달한다.
    location /camera/pinky-01/front/ {
        proxy_pass http://127.0.0.1:18801/;
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

    location /camera/pinky-01/rear/ {
        proxy_pass http://127.0.0.1:18802/;
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

    location /camera/pinky-02/front/ {
        proxy_pass http://127.0.0.1:18803/;
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

    location /camera/pinky-02/rear/ {
        proxy_pass http://127.0.0.1:18804/;
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

}
