#!/usr/bin/env bash
# 팀원 계정을 만든다.
#
#   sudo mingky-adduser <계정명> <공개키파일>
#   sudo mingky-adduser dayeong /tmp/dayeong.pub
#
# 하는 일
#   - 계정 생성, mingky·sudo 그룹 편입
#   - 공개키 등록 (비밀번호 로그인은 서버 전체가 이미 꺼져 있다)
#   - 비어 있는 ROS_DOMAIN_ID 를 배정하고 .bashrc 최상단에서 읽게 한다
set -euo pipefail

DOMAIN_CONF=/etc/mingky/ros-domains.conf
DOMAIN_MIN=30
DOMAIN_MAX=98

usage() { echo "사용법: sudo mingky-adduser <계정명> <공개키파일>" >&2; exit 1; }

[ $# -eq 2 ] || usage
user="$1"; keyfile="$2"

[ -r "$keyfile" ] || { echo "[실패] 공개키 파일을 읽을 수 없다: $keyfile" >&2; exit 1; }
grep -qE '^(ssh-(rsa|ed25519)|ecdsa-)' "$keyfile" || {
    echo "[실패] 공개키 형식이 아니다. id_*.pub 내용인지 확인하라: $keyfile" >&2; exit 1; }
grep -q 'PRIVATE KEY' "$keyfile" && {
    echo "[실패] 개인키다. .pub 파일을 받아라." >&2; exit 1; }

if id -u "$user" >/dev/null 2>&1; then
    echo "[건너뜀] 계정 $user 는 이미 있다. 키만 추가한다."
else
    adduser --disabled-password --gecos "" "$user"
fi

usermod -aG mingky,sudo "$user"

install -d -m 700 -o "$user" -g "$user" "/home/$user/.ssh"
touch "/home/$user/.ssh/authorized_keys"
# 같은 키를 두 번 넣지 않는다
if ! grep -qxF "$(cat "$keyfile")" "/home/$user/.ssh/authorized_keys"; then
    cat "$keyfile" >> "/home/$user/.ssh/authorized_keys"
fi
chmod 600 "/home/$user/.ssh/authorized_keys"
chown -R "$user:$user" "/home/$user/.ssh"

# ROS_DOMAIN_ID 배정
if grep -q "^${user}:" "$DOMAIN_CONF"; then
    domain="$(awk -F: -v u="$user" '$1==u {print $2}' "$DOMAIN_CONF")"
    echo "[유지] 기존 도메인 $domain"
else
    used="$(awk -F: '/^[^#]/ {print $2}' "$DOMAIN_CONF")"
    domain=""
    for candidate in $(seq "$DOMAIN_MIN" "$DOMAIN_MAX"); do
        if ! echo "$used" | grep -qx "$candidate"; then domain="$candidate"; break; fi
    done
    [ -n "$domain" ] || { echo "[실패] 남은 도메인 ID 가 없다." >&2; exit 1; }
    echo "${user}:${domain}" >> "$DOMAIN_CONF"
    echo "[배정] ROS_DOMAIN_ID=$domain"
fi

# .bashrc 최상단에 넣는다. 조기 return 아래에 두면 비대화형 셸에 적용되지 않는다.
bashrc="/home/$user/.bashrc"
marker='# mingky: ROS_DOMAIN_ID'
if ! grep -qF "$marker" "$bashrc" 2>/dev/null; then
    tmp="$(mktemp)"
    {
        echo "$marker — 비대화형 셸에도 적용되어야 하므로 조기 return 앞에 둔다"
        echo '[ -r /etc/mingky/ros-domain.sh ] && . /etc/mingky/ros-domain.sh'
        echo ''
        cat "$bashrc" 2>/dev/null || true
    } > "$tmp"
    cp "$tmp" "$bashrc"
    rm -f "$tmp"
    chown "$user:$user" "$bashrc"
fi

echo
echo "[완료] $user"
echo "  ROS_DOMAIN_ID : $domain"
echo "  그룹          : $(id -nG "$user")"
echo "  확인          : ssh ${user}@mingkycarepro.site 'echo \$ROS_DOMAIN_ID'"
