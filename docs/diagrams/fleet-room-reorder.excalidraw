      "versionNonce": 6033,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773161826574,
      "link": null,
      "locked": false,
      "text": "X-ray 를 1호가 잡았다\n→ 2호는 뒤에서 비어 있는\n   첫 번째로",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X-ray 를 1호가 잡았다\n→ 2호는 뒤에서 비어 있는\n   첫 번째로",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e34",
      "type": "text",
      "x": 720,
      "y": 310,
      "width": 139.29999999999998,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a34",
      "roundness": null,
      "seed": 5034,
      "version": 1,
      "versionNonce": 6034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773161826574,
      "link": null,
      "locked": false,
      "text": "건너뛴 검사로 반드시\n돌아온다",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "건너뛴 검사로 반드시\n돌아온다",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
