    },
    {
      "id": "e36",
      "type": "text",
      "x": 40,
      "y": 420,
      "width": 508.00000000000017,
      "height": 20.0,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a36",
      "roundness": null,
      "seed": 5036,
      "version": 1,
      "versionNonce": 6036,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773161826574,
      "link": null,
      "locked": false,
      "text": "배정은 차례대로 — 한꺼번에 각자 고르면 둘 다 X-ray 를 피한다",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "배정은 차례대로 — 한꺼번에 각자 고르면 둘 다 X-ray 를 피한다",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e37",
      "type": "text",
      "x": 40,
      "y": 450,
      "width": 576.0999999999999,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a37",
      "roundness": null,
      "seed": 5037,
      "version": 1,
      "versionNonce": 6037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773161826574,
      "link": null,
      "locked": false,
      "text": "실측으로 잡은 버그다. 각 로봇을 독립적으로 판정했더니, 아직 아무도 출발 안 한 상태에서\n서로 '상대가 쓸 것' 으로 보고 둘 다 양보했다. X-ray 는 비어 있는데 아무도 안 갔다.",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "실측으로 잡은 버그다. 각 로봇을 독립적으로 판정했더니, 아직 아무도 출발 안 한 상태에서\n서로 '상대가 쓸 것' 으로 보고 둘 다 양보했다. X-ray 는 비어 있는데 아무도 안 갔다.",
      "autoResize": true,
      "lineHeight": 1.25
    },
