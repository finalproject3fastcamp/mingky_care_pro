+class _StdinKeyListener:
+    """
+    Reads arrow keys and escape from the controlling terminal in a background thread.
+
+    Unlike pynput's global hook this only sees keys typed into the terminal running the
+    command, but it does not depend on X11 and therefore also works on Wayland.
+    """
+
+    def __init__(self, on_key):
+        self._on_key = on_key
+        self._stop_event = threading.Event()
+        self._thread = None
+        self._saved_term = None
+        try:
+            self._fd = sys.stdin.fileno()
+            self._is_tty = os.isatty(self._fd)
+        except (AttributeError, ValueError, OSError):
+            self._fd = None
+            self._is_tty = False
+
+    def available(self):
+        return self._is_tty
+
+    def start(self):
+        self._saved_term = termios.tcgetattr(self._fd)
+        tty.setcbreak(self._fd)
+        # Leaving the terminal in cbreak mode makes the shell unusable, so restore it even
+        # if the caller never reaches its cleanup path.
+        atexit.register(self._restore_terminal)
+        self._thread = threading.Thread(target=self._run, daemon=True)
+        self._thread.start()
+
+    def _run(self):
+        while not self._stop_event.is_set():
+            if not select.select([self._fd], [], [], 0.1)[0]:
+                continue
+            char = os.read(self._fd, 1)
+            if char == b" ":
+                # Spacebar toggles human intervention during DAgger recording.
+                self._on_key("space")
+                continue
+            if char != b"\x1b":
+                continue
+            # Either a bare escape or the start of a "\x1b[<X>" arrow sequence. Only the
+            # latter has more bytes pending almost immediately.
+            if not select.select([self._fd], [], [], 0.05)[0]:
+                self._on_key("esc")
+                continue
+            rest = os.read(self._fd, 2)
+            if rest == b"[C":
+                self._on_key("right")
+            elif rest == b"[D":
+                self._on_key("left")
+
+    def _restore_terminal(self):
+        if self._saved_term is not None:
+            termios.tcsetattr(self._fd, termios.TCSADRAIN, self._saved_term)
+            self._saved_term = None
+
+    def stop(self):
+        self._stop_event.set()
+        if self._thread is not None:
+            self._thread.join(timeout=1.0)
+        self._restore_terminal()
+
