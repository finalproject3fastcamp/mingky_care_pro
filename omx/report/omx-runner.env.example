# OMX 박스 러너 설정. 박스마다 이 러너를 띄우고, 클라우드 백엔드가 robot_id 별로
# 여기에 프록시한다. `/etc/mingky/omx-runner.env` 로 복사해 채운다.
#
#   박스     역할            주소            러너 포트   백엔드가 보는 URL
#   omx-01   조제 스테이션   192.168.x.41    8800        MINGKY_OMX_DISPENSE_URL
#   omx-02   포장 스테이션   192.168.x.97    8800        MINGKY_OMX_PACK_URL
#
# 백엔드 쪽(관제) env 에는 아래를 건다 — 그래야 pharmacy.py 가 로컬 서브프로세스
# 대신 이 러너로 프록시한다. 비우면 기존 로컬/시뮬 동작 그대로다(CI·데모 불변):
#
#   MINGKY_OMX_DISPENSE_URL=http://192.168.x.41:8800
#   MINGKY_OMX_PACK_URL=http://192.168.x.97:8800

# 러너가 붙을 주소·포트.
MINGKY_RUNNER_HOST=0.0.0.0
MINGKY_RUNNER_PORT=8800

# 조제 파트 경로. run.sh 가 있는 조제 담당자 작업 디렉터리와 il venv 파이썬.
OMX_PILL_ROOT=/home/omx/omx_pill_project
OMX_PYTHON=/home/omx/venv/il/bin/python

# 포장 체크포인트(포장 박스에서만 의미 있음). 로컬 경로이거나 HF Hub repo id.
PACK_CKPT=~/train/act_pill_bottle_v1/checkpoints/last/pretrained_model
PACK_SECONDS=60

# 색 하나에 주는 최대 시간[초]·트레이 계수 프레임 수·트레이 타임아웃[초].
MINGKY_RUNNER_PICK_TIMEOUT=150
MINGKY_RUNNER_TRAY_FRAMES=5
MINGKY_RUNNER_TRAY_TIMEOUT=60

# 하드웨어 없이 배관만 확인할 때 1. 스크립트를 띄우지 않고 각 단계를 흉내 낸다.
MINGKY_RUNNER_SIM=0
