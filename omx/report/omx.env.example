# OMX 스테이션 리포터 설정. 박스마다 다른 유일한 값이라 코드·유닛이 아니라
# 여기에 둔다. `/etc/mingky/omx.env` 로 복사해 채운다.
#
# **이 값이 설정돼야** pharmacy 워커가 조제/포장 라이프사이클 이벤트를 관제로
# 발행하고, 리포터가 heartbeat 를 보낸다. 비우면 아무 것도 나가지 않는다
# (데모·CI·개발에서는 그대로 조용하다).
#
#   박스     역할              주소              MINGKY_OMX_ROBOT_ID
#   omx-01   조제 스테이션     192.168.x.41      omx-01
#   omx-02   포장 스테이션     192.168.x.97      omx-02
#
# 조제 박스(.41)는 PHARMACY_REAL 로, 포장 박스(.97)는 PACK_REAL 로 실기를 켠다.
# 리포터는 어느 쪽이든 무관하게 heartbeat 만 보내고, 라이프사이클 이벤트는
# 백엔드 pharmacy 워커가 발행한다.
MINGKY_OMX_ROBOT_ID=omx-01

# 관제 백엔드. 기본은 클라우드다. 관제 PC 와 같은 LAN 이면 로컬 주소를 쓴다
# (아래 '한계' 참조). 경로는 반드시 /api 까지 적는다.
MINGKY_BACKEND_URL=https://mingkycarepro.site/api

# heartbeat 주기 [초]. 서버의 두절 판정 창보다 짧아야 멀쩡한 박스에 comm_lost
# 가 찍히지 않는다. 게이트웨이(핑키)와 같은 5초를 기본으로 둔다.
MINGKY_OMX_HEARTBEAT_INTERVAL=5

# HTTP 타임아웃 [초]. 실패하면 조용히 버린다(재전송 안 함).
MINGKY_OMX_HTTP_TIMEOUT=5
