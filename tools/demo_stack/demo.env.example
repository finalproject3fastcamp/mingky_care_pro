# 데모 스택 설정. /etc/mingky/demo.env 로 복사해서 쓴다.

# 백엔드 주소. 클라우드 서버 안에서 도는 것이므로 nginx 를 거치지 않고
# 컨테이너가 열어 둔 포트로 바로 간다 — 자기 자신에게 https 로 나갔다
# 돌아올 이유가 없다.
#
# deploy/compose.yaml 이 frontend 만 포트를 내보내므로, 백엔드에 직접 닿으려면
# 아래 둘 중 하나다.
#   1) 프론트엔드(nginx) 를 거친다:  http://127.0.0.1:8080/api
#   2) compose 에서 backend 포트를 열고 직접 간다
# 1 번이 배포를 안 건드려서 낫다.
MINGKY_DEMO_BASE_URL=http://127.0.0.1:8080/api

# 상시 재생할 시나리오. 4대를 한 이야기로 도는 것이 기본이다.
MINGKY_DEMO_SCENARIO=/opt/mingky-demo/tools/fake_robot/scenarios/demo_showcase.yaml

# 회차 사이 대기. 세션이 닫히고 화면이 '복귀 완료' 를 보여줄 틈을 준다.
MINGKY_DEMO_LOOP_DELAY=12

# teleop 브리지를 붙일 로봇. omx 는 팔이라 주행 좌표가 없다.
MINGKY_DEMO_ROBOTS=pinky-01,pinky-02

# 카메라
MINGKY_DEMO_FRAMES_DIR=/opt/mingky-demo/frames
MINGKY_DEMO_FPS=12
